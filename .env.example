# Never commit a real PAT or consumer credential.
KONNECT_TOKEN=
KONNECT_REGION=us
KONNECT_AI_GATEWAY_ID=
# Create five distinct local values before applying kong/airlock.yaml. Never
# reuse a key between agents or commit these values.
PLANNER_AGENT_KEY=replace-with-a-local-planner-key
RESEARCH_AGENT_KEY=replace-with-a-local-research-key
SECURITY_AGENT_KEY=replace-with-a-local-security-key
CODING_AGENT_KEY=replace-with-a-local-coding-key
APPROVAL_CODING_AGENT_KEY=replace-with-a-local-server-only-approval-key
# Kong's official AI Gateway quickstart creates this Konnect-managed data plane
# on airlock-net. It replaces the former standalone local Kong service.
KONG_PROXY_URL=http://airlock-gateway:8000
DATABASE_URL=postgresql://airlock:airlock@postgres:5432/airlock
PRIMARY_OLLAMA_URL=http://host.docker.internal:11434
FALLBACK_OLLAMA_URL=http://host.docker.internal:11434
KONG_TELEMETRY_TOKEN=replace-with-a-local-random-token
